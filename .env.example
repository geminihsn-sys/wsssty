# --- Database ---
# SQLite file (relative to the /prisma directory). Swap for a Postgres/MySQL
# URL in production, e.g. postgresql://user:pass@host:5432/walidstyle
DATABASE_URL="file:./dev.db"

# --- Admin dashboard auth ---
# Password used on the /admin/login screen.
ADMIN_PASSWORD="walid-admin-2026"
# Secret used to sign the admin session cookie. Use a long random string in
# production (e.g. `openssl rand -base64 32`).
ADMIN_SESSION_SECRET="please-change-this-to-a-long-random-secret"
